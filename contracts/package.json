{
  "name": "prepaidguard-contracts",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
