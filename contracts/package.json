    "@openzeppelin/contracts": "5.6.1",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.0",
    "chai": "6.3.0",
    "ethers": "6.17.0",
    "hardhat": "3.21.2",
    "mocha": "12.0.3",
    "typescript": "5.9.3"
  }
