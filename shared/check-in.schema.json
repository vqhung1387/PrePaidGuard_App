{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrePaidGuard CheckIn QR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "chainId",
    "verifyingContract",
    "message",
    "signature"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "PREPAIDGUARD_CHECK_IN"
    },
    "chainId": {
      "type": "integer",
      "minimum": 1
    },
    "verifyingContract": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscriptionId",
        "merchant",
        "periodIndex",
        "nonce",
        "deadline"
      ],
      "properties": {
        "subscriptionId": {
          "type": "string",
          "pattern": "^[0-9]{1,78}$"
        },
        "merchant": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "periodIndex": {
          "type": "string",
          "pattern": "^[0-9]{1,78}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9]{1,78}$"
        },
        "deadline": {
          "type": "string",
          "pattern": "^[0-9]{1,78}$"
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{130}$"
    }
  }
}
