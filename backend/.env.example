# Run from backend/. Replace the local database URL and generate a signing secret.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/prepaidguard
ACCESS_TOKEN_SECRET=
AUTH_DOMAIN=localhost:8000
AUTH_URI=http://localhost:8000
ACCESS_TOKEN_TTL_SECONDS=3600
CHALLENGE_RATE_LIMIT=10
CORS_ORIGINS=[]

# Paths relative to backend/ or absolute. Point to the contract team's exports.
CHAIN_ID=43113
ABI_FILE=
DEPLOYMENT_FILE=
# Optional server-only RPC override; never use a private RPC URL in the manifest.
RPC_URL=
RPC_TIMEOUT_SECONDS=5
SYNC_BATCH_SIZE=90
SYNC_OVERLAP=8
SYNC_INTERVAL_SECONDS=0
